// Thing Factory on Cloudflare: the ttdat Worker. Its static assets (the ship build) serve
// every file; worker/index.js (plain JS, no build) gets only the requests that match none, and
// answers POST /t (telemetry batches into D1, D-64) and 404 to anything else.
// `just deploy` runs `just ship` first, so ./dist/web is the current commit's files.
{
  "name": "ttdat",
  "main": "worker/index.js",
  "compatibility_date": "2025-04-01",
  "assets": { "directory": "./dist/web" },
  // No Cloudflare request logging: nothing about a request (its IP least of all) is kept (D-64).
  "observability": { "enabled": false },

  // Telemetry (D-64). This top-level block is what `wrangler dev` uses, with the database in
  // local files under .wrangler/, so its id is a made-up one naming no real database: a deploy
  // without `--env production` fails on it. `just d1-local` applies worker/telemetry_schema.sql
  // to the local database.
  "d1_databases": [
    { "binding": "TELEMETRY", "database_name": "ttdat-telemetry", "database_id": "local-only-ttdat-telemetry" }
  ],

  // Routes live only under env.production so `wrangler dev` carries none. `name` is
  // pinned so the env doesn't deploy as "ttdat-production". custom_domain has Cloudflare
  // create the DNS record and the certificate on the first deploy; it fails if a DNS record
  // for ttdat.yuwakisa.com already exists.
  "env": {
    "production": {
      "name": "ttdat",
      "routes": [{ "pattern": "ttdat.yuwakisa.com", "custom_domain": true }],
      "observability": { "enabled": false },
      // Bindings don't inherit into an environment, so it is restated here. The production
      // database doesn't exist until `just d1-production` creates it and prints its id, which
      // replaces the placeholder below; run again, the recipe applies the schema. `just deploy`
      // refuses while the placeholder is here.
      "d1_databases": [
        { "binding": "TELEMETRY", "database_name": "ttdat-telemetry", "database_id": "PUT-THE-DATABASE-ID-HERE" }
      ]
    }
  }
}
